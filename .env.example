# ============================================================
# NoteWave — biến môi trường. Copy thành `.env` (không commit file .env).
# Backend đọc file .env ở gốc repo (hoặc server/.env). Trên Render: khai báo trong Dashboard.
# ============================================================

# --- Soniox Speech-to-Text (lấy key tại https://console.soniox.com) ---
# Key CHÍNH, chỉ dùng ở backend. Client chỉ nhận Temporary API Key qua POST /api/temporary-key.
SONIOX_API_KEY=
# Model cho luồng tải file lên (Async API). Mặc định: stt-async-v5
SONIOX_ASYNC_MODEL=stt-async-v5

# --- Database: Supabase Postgres — local và production dùng CÙNG MỘT connection string ---
# Lấy ở Supabase Dashboard > nút "Connect" (hoặc Project Settings > Database) > Connection string >
#   "Transaction pooler" (cổng 6543). Thay [YOUR-PASSWORD] bằng mật khẩu DB (URL-encode ký tự đặc biệt,
#   vd @ -> %40) và thêm ?sslmode=require vào cuối, vd:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Dán đúng giá trị này vào .env ở local VÀ vào Environment của Render. Không dùng Direct connection (chỉ IPv6).
# ⚠️ Local ghi/xoá thẳng vào dữ liệu THẬT của production (chung 1 project Supabase) — xem README mục "Chạy local".
# (Tuỳ chọn) TEST_DATABASE_URL: DB cho pytest; trống = dùng DATABASE_URL (test chỉ ghi vào schema `notewave_test`).
DATABASE_URL=

# --- CORS: các domain frontend được phép gọi API (phân cách bằng dấu phẩy, không dùng *) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- PydanticAI summary_agent ---
# Cú pháp provider:model-name, vd: openai:gpt-5.6-luna | anthropic:claude-sonnet-5 | google:gemini-2.5-flash
SUMMARY_MODEL=openai:gpt-5.6-luna
# (Tuỳ chọn, chỉ cho model OpenAI) mức reasoning: none | low | medium | high. Để trống = mặc định của model
# (khuyên để trống với gpt-5.6-luna: tóm tắt chính xác hơn; "low" nhanh hơn ~2 lần nhưng dễ trùng/sai việc cần làm)
SUMMARY_REASONING_EFFORT=
# Chỉ cần điền key của provider đang dùng ở SUMMARY_MODEL
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Mistral OCR: luồng "Quét tài liệu" (ảnh chụp / PDF) — lấy key tại https://console.mistral.ai/api-keys ---
# Key chỉ dùng ở backend. Bước rà soát từ tiếng Anh sau OCR dùng chung SUMMARY_MODEL + key LLM ở trên.
MISTRAL_API_KEY=
# (Tuỳ chọn) model OCR. Mặc định: mistral-ocr-latest
OCR_MODEL=mistral-ocr-latest

# --- Supabase Storage: ảnh trong Ghi chú (bucket PRIVATE, backend tự tạo ở lần tải ảnh đầu tiên) ---
# Secret key: Supabase Dashboard > Project Settings > API Keys > Secret keys (sb_secret_...) — hoặc khoá service_role cũ.
# CHỈ dùng ở backend, tuyệt đối không đưa ra frontend. Trống -> nút chèn ảnh bị tắt (POST /api/notes/{id}/images trả 503).
SUPABASE_SECRET_KEY=
# (Tuỳ chọn) URL project, vd https://<ref>.supabase.co. Trống -> tự suy ra từ project-ref trong DATABASE_URL.
SUPABASE_URL=
# (Tuỳ chọn) tên bucket. Mặc định: note-assets
NOTE_ASSETS_BUCKET=note-assets
# (Tuỳ chọn) dung lượng tối đa mỗi ảnh (MB, sau khi trình duyệt đã nén). Mặc định: 10
NOTE_IMAGE_MAX_MB=10

# --- Webhook Soniox (chỉ dùng khi backend có domain public, vd sau khi deploy Render) ---
# Để trống khi dev local -> frontend dùng polling.
PUBLIC_BASE_URL=
# Chuỗi bí mật ngẫu nhiên; Soniox gửi kèm header "Authorization: Bearer <secret>" khi gọi webhook
SONIOX_WEBHOOK_SECRET=

# --- Giới hạn dung lượng file ghi âm tải lên (MB) ---
# (File quét tài liệu cố định theo giới hạn Mistral OCR: tối đa 50 MB, 1000 trang.)
MAX_UPLOAD_MB=100
