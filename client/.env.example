# URL backend. Dev local: để trống (Vite proxy /api -> http://localhost:8000).
# Production (Vercel): URL Render, vd https://notewave-api.onrender.com
VITE_API_BASE_URL=

# Model Soniox real-time cho ghi âm trực tiếp
VITE_SONIOX_RT_MODEL=stt-rt-v5

# Giới hạn dung lượng file ở phía client (nên khớp MAX_UPLOAD_MB của backend)
VITE_MAX_UPLOAD_MB=100
